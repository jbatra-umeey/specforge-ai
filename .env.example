# Local development only. Replace both values before running Compose.
SPECFORGE_API_KEY=replace-with-a-long-random-development-key
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
SPECFORGE_ENV=development
AUTH_MODE=development
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Live planner: no mock fallback when these are empty.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Production OIDC: public browser client, authorization code + PKCE, RS256 access tokens.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles

# Service credentials belong to exactly one tenant. Development tenant is local.
INTEGRATION_TENANT_ID=local
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ALLOWED_PROJECTS=
JIRA_ISSUE_TYPE=Task
